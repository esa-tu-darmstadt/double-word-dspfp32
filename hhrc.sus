
module SUS_DWTimesDW_Fast {
    clock aclk

    gen int TYPE = 7

    output bool                               saxis_a_tready'0 = true
    input  bool                               saxis_a_tvalid'0
    input  bool[128]                          saxis_a_tdata'0
    input  bool[16]                           saxis_a_tkeep'0
    input  bool                               saxis_a_tlast'0

    output bool                               saxis_b_tready'0 = true
    input  bool                               saxis_b_tvalid'0
    input  bool[128]                          saxis_b_tdata'0
    input  bool[16]                           saxis_b_tkeep'0
    input  bool                               saxis_b_tlast'0

    input  bool                               maxis_tready'0
    output bool                               maxis_tvalid'0 = true
    output bool[128]                          maxis_tdata
    output bool[16]                           maxis_tkeep'0 = FromBits(16'b0)
    output bool                               maxis_tlast'0 = false

    bool      _saxis_a_tvalid = saxis_a_tvalid
    bool[16]  _saxis_a_tkeep  = saxis_a_tkeep
    bool      _saxis_a_tlast  = saxis_a_tlast
    bool      _saxis_b_tvalid = saxis_b_tvalid
    bool[16]  _saxis_b_tkeep  = saxis_b_tkeep
    bool      _saxis_b_tlast  = saxis_b_tlast
    bool      _maxis_tready   = maxis_tready

    if TYPE == 0 {
        FPPlusFP inst
        inst.x = FromBits(saxis_a_tdata[0+:32])
        inst.y = FromBits(saxis_b_tdata[0+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    } else if TYPE == 1 {
        DWPlusFP inst
        inst.xh = FromBits(saxis_a_tdata[0+:32])
        inst.xl = FromBits(saxis_a_tdata[32+:32])
        inst.y = FromBits(saxis_b_tdata[0+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    } else if TYPE == 2 {
        DWPlusDW_Sloppy inst
        inst.xh = FromBits(saxis_a_tdata[0+:32])
        inst.xl = FromBits(saxis_a_tdata[32+:32])
        inst.yh = FromBits(saxis_b_tdata[0+:32])
        inst.yl = FromBits(saxis_b_tdata[32+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    } else if TYPE == 3 {
        DWPlusDW_Accurate inst
        inst.xh = FromBits(saxis_a_tdata[0+:32])
        inst.xl = FromBits(saxis_a_tdata[32+:32])
        inst.yh = FromBits(saxis_b_tdata[0+:32])
        inst.yl = FromBits(saxis_b_tdata[32+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    } else if TYPE == 4 {
        FPTimesFP inst
        inst.x = FromBits(saxis_a_tdata[0+:32])
        inst.y = FromBits(saxis_b_tdata[0+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    } else if TYPE == 5 {
        DWTimesFP_Fast inst
        inst.xh = FromBits(saxis_a_tdata[0+:32])
        inst.xl = FromBits(saxis_a_tdata[32+:32])
        inst.y = FromBits(saxis_b_tdata[0+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    } else if TYPE == 6 {
        DWTimesFP_Accurate inst
        inst.xh = FromBits(saxis_a_tdata[0+:32])
        inst.xl = FromBits(saxis_a_tdata[32+:32])
        inst.y = FromBits(saxis_b_tdata[0+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    } else if TYPE == 7 {
        DWTimesDW_Fast inst
        inst.xh = FromBits(saxis_a_tdata[0+:32])
        inst.xl = FromBits(saxis_a_tdata[32+:32])
        inst.yh = FromBits(saxis_b_tdata[0+:32])
        inst.yl = FromBits(saxis_b_tdata[32+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    }

}

module testbench {

    input float[20] vals'0
    output bool[8] valids

    FPPlusFP inst0
    inst0.x = vals[0]
    inst0.y = vals[2]
    bool valid0 = BitsToUInt(ToBits(vals[4])) == BitsToUInt(ToBits(inst0.rh)) & BitsToUInt(ToBits(vals[5])) == BitsToUInt(ToBits(inst0.rl))
    valids[0] = valid0

    DWPlusFP inst1
    inst1.xh = vals[0]
    inst1.xl = vals[1]
    inst1.y = vals[2]
    bool valid1 = BitsToUInt(ToBits(vals[6])) == BitsToUInt(ToBits(inst1.rh)) & BitsToUInt(ToBits(vals[7])) == BitsToUInt(ToBits(inst1.rl))
    valids[1] = valid1

    DWPlusDW_Sloppy inst2
    inst2.xh = vals[0]
    inst2.xl = vals[1]
    inst2.yh = vals[2]
    inst2.yl = vals[3]
    bool valid2 = BitsToUInt(ToBits(vals[8])) == BitsToUInt(ToBits(inst2.rh)) & BitsToUInt(ToBits(vals[9])) == BitsToUInt(ToBits(inst2.rl))
    valids[2] = valid2

    DWPlusDW_Accurate inst3
    inst3.xh = vals[0]
    inst3.xl = vals[1]
    inst3.yh = vals[2]
    inst3.yl = vals[3]
    bool valid3 = BitsToUInt(ToBits(vals[10])) == BitsToUInt(ToBits(inst3.rh)) & BitsToUInt(ToBits(vals[11])) == BitsToUInt(ToBits(inst3.rl))
    valids[3] = valid3

    FPTimesFP inst4
    inst4.x = vals[0]
    inst4.y = vals[2]
    bool valid4 = BitsToUInt(ToBits(vals[12])) == BitsToUInt(ToBits(inst4.rh)) & BitsToUInt(ToBits(vals[13])) == BitsToUInt(ToBits(inst4.rl))
    valids[4] = valid4

    DWTimesFP_Fast inst5
    inst5.xh = vals[0]
    inst5.xl = vals[1]
    inst5.y = vals[2]
    bool valid5 = BitsToUInt(ToBits(vals[14])) == BitsToUInt(ToBits(inst5.rh)) & BitsToUInt(ToBits(vals[15])) == BitsToUInt(ToBits(inst5.rl))
    valids[5] = valid5

    DWTimesFP_Accurate inst6
    inst6.xh = vals[0]
    inst6.xl = vals[1]
    inst6.y = vals[2]
    bool valid6 = BitsToUInt(ToBits(vals[16])) == BitsToUInt(ToBits(inst6.rh)) & BitsToUInt(ToBits(vals[17])) == BitsToUInt(ToBits(inst6.rl))
    valids[6] = valid6

    DWTimesDW_Fast inst7
    inst7.xh = vals[0]
    inst7.xl = vals[1]
    inst7.yh = vals[2]
    inst7.yl = vals[3]
    bool valid7 = BitsToUInt(ToBits(vals[18])) == BitsToUInt(ToBits(inst7.rh)) & BitsToUInt(ToBits(vals[19])) == BitsToUInt(ToBits(inst7.rl))
    valids[7] = valid7

}

// ################################################################
// ##  Algorithms  ################################################
// ################################################################

module FPPlusFP {
    clock aclk

    input float x'0
    input float y'0

    output float rh
    output float rl

    TwoSum2 r
    r.a = x
    r.b = y

    rh = r.rh
    rl = r.rl
}

module DWPlusFP {
    clock aclk

    input float xh'0
    input float xl'0
    input float y'0

    output float rh
    output float rl

    TwoSum2 s
    s.a = xh
    s.b = y
    float sh = s.rh
    float sl = s.rl
    float slc = s.rlc

    dspfp32_add_c_pcin#(C_REGS: 3) dsp0
    dsp0.apply(xl, slc)
    float v = dsp0.fpa_out
    float vc = dsp0.pcout

    FastTwoSum#(A_LATENCY: 3) r
    r.a = sh
    r.b = v
    r.bc = vc

    /*
    two<T> s = algorithms::TwoSum(x.h, y);
    T v = x.l + s.l;
    return algorithms::FastTwoSum(s.h, v);
    */

    rh = r.rh
    rl = r.rl
}

module DWPlusDW_Sloppy {
    clock aclk

    input float xh'0
    input float xl'0
    input float yh'0
    input float yl'0

    output float rh
    output float rl

    TwoSum2 s
    s.a = xh
    s.b = yh
    float sh   = s.rh
    float _shc = s.rhc
    float _sl  = s.rl
    float slc  = s.rlc

    dspfp32_add#(D_LATENCY: 1, C_LATENCY: 1) x0
    x0.d = xl
    x0.c = yl
    float v = x0.res

    dspfp32_add_c_pcin#(C_REGS: 1) dsp0
    dsp0.apply(v, slc)
    float w = dsp0.fpa_out
    float wc = dsp0.pcout

    FastTwoSum#(A_LATENCY: 3) r
    r.a = sh
    r.b = w
    r.bc = wc
    float _rhc = r.rhc
    float _rlc = r.rlc

    /*
    two<T> s = algorithms::TwoSum(x.h, y.h);
    T v = x.l + y.l;
    T w = s.l + v;
    return algorithms::FastTwoSum(s.h, w);
    */

    rh = r.rh
    rl = r.rl
}

module DWPlusDW_Accurate {
    clock aclk

    input float xh'0
    input float xl'0
    input float yh'0
    input float yl'0

    output float rh
    output float rl

    TwoSum2 s
    s.a = xh
    s.b = yh
    float sh = s.rh
    float sl = s.rl
    float _shc = s.rhc
    float slc = s.rlc

    TwoSum2 t
    t.a = xl
    t.b = yl
    float th = t.rh
    float tl = t.rl
    float _thc = t.rhc
    float _tlc = t.rlc

    //dspfp32_add#(D_LATENCY: 0, C_LATENCY: 3) x0

    dspfp32_add_c_pcin#(C_REGS: 2) dsp0
    dsp0.apply(th, slc)
    float c = dsp0.fpa_out
    float cc = dsp0.pcout

    FastTwoSum#(A_LATENCY: 3) v
    v.a = sh
    v.b = c
    v.bc = cc
    float vh = v.rh
    float vl = v.rlc

    dspfp32_mac_a_b_pcin#(A_REGS: 2, B_REGS: 0) dsp1
    dsp1.apply(tl, 1.0, vl)
    float w = dsp1.fpa_out
    float _t1 = dsp1.fpm_out
    float wc = dsp1.pcout

    FastTwoSum#(A_LATENCY: 3) r
    r.a = vh
    r.b = w
    r.bc = wc

    /*
    two<T> s = algorithms::TwoSum(x.h, y.h);
    two<T> t = algorithms::TwoSum(x.l, y.l);
    T c = s.l + t.h;
    two<T> v = algorithms::FastTwoSum(s.h, c);
    T w = t.l + v.l;
    return algorithms::FastTwoSum(v.h, w);
    */

    rh = r.rh
    rl = r.rl
}

module FPTimesFP {
    clock aclk

    input float x'0
    input float y'0

    output float rh
    output float rl

    TwoProd r
    r.a = x
    r.b = y

    rh = r.rh
    rl = r.rl
}

module DWTimesFP_Fast {
    clock aclk

    input float xh'0
    input float xl'0
    input float y'0

    output float rh
    output float rl

    TwoProd c
    c.a = xh
    c.b = y
    float ch = c.rh
    float cl = c.rlc

    dspfp32_mac_a_b_c#(A_REGS: 1, B_REGS: 1, C_REGS: 0) dsp0
    dsp0.apply(xl, y, 0.0)
    float cl2 = dsp0.fpa_out
    float _t0 = dsp0.fpm_out
    float _t1 = dsp0.pcout

    dspfp32_mul_a_b_add_c_pcin#(A_REGS: 2, B_REGS: 0, C_REGS: 2) dsp2
    float cl2m = dsp2.fpm_out
    dsp2.mul(cl2, 1.0)
    dsp2.add(cl2m, cl)
    float cl3c = dsp2.pcout
    float cl3 = dsp2.fpa_out

    FastTwoSum#(A_LATENCY: 7) r
    r.a = ch
    r.b = cl3
    r.bc = cl3c
    float _rh = r.rh
    float _rl = r.rl

    rh = _rh
    rl = _rl

    /*
    two<T> c = algorithms::TwoProd(x.h, y);
    T cl2 = x.l * y;
    T cl3 = c.l + cl2;
    return algorithms::FastTwoSum(c.h, cl3);
    */

}

module DWTimesFP_Accurate {
    clock aclk

    input float xh'0
    input float xl'0
    input float y'0

    output float rh
    output float rl

    TwoProd c
    c.a = xh
    c.b = y
    float ch = c.rh
    float chc = c.rhc
    float cl = c.rlc

    dspfp32_mul_a_b#(A_REGS: 1, B_REGS: 1) dsp0
    dsp0.apply(xl, y)
    float cl2 = dsp0.fpm_out
    float _t1 = dsp0.pcout

    FastTwoSumB#(B_REGS: 1) t
    t.a = ch
    t.ac = chc
    t.b = cl2
    float th = t.rh
    float tl = t.rl

    dspfp32_add_c_pcin#(C_REGS: 3) dsp1
    dsp1.apply(tl, cl)
    float tl2 = dsp1.fpa_out
    float tl2c = dsp1.pcout

    FastTwoSum#(A_LATENCY: 6) r
    r.a = th
    r.b = tl2
    r.bc = tl2c
    float _rh = r.rh
    float _rl = r.rl

    rh = _rh
    rl = _rl

    /*
    two<T> c = algorithms::TwoProd(x.h, y);
    T cl2 = x.l * y;
    two<T> t = algorithms::FastTwoSum(c.h, cl2);
    T tl2 = t.l + c.l;
    return algorithms::FastTwoSum(t.h, tl2);
    */

}

module DWTimesDW_Fast {
    clock aclk

    input float xh'0
    input float xl'0
    input float yh'0
    input float yl'0

    output float rh
    output float rl

    TwoProd c
    c.a = xh
    c.b = yh
    float ch = c.rh
    float cl = c.rlc

    dspfp32_mul_a_b#(A_REGS: 1, B_REGS: 1) dsp0
    dsp0.apply(xh, yl)
    float tl1 = dsp0.pcout

    dspfp32_mac_a_b_pcin#(A_REGS: 1, B_REGS: 1) dsp1
    dsp1.apply(xl, yh, tl1)
    float _tl2 = dsp1.fpm_out
    float cl2 = dsp1.fpa_out

    dspfp32_mul_a_b_add_c_pcin#(A_REGS: 2, B_REGS: 0, C_REGS: 2) dsp2
    float cl2m = dsp2.fpm_out
    dsp2.mul(cl2, 1.0)
    dsp2.add(cl2m, cl)
    float cl3c = dsp2.pcout
    float cl3  = dsp2.fpa_out

    FastTwoSum#(A_LATENCY: 7) r
    r.a = ch
    r.b = cl3
    r.bc = cl3c

    rh = r.rh
    rl = r.rl

    /*
    two<T> c = algorithms::TwoProd(x.h, y.h);
    T tl1 = x.h * y.l;
    T tl2 = x.l * y.h;
    T cl2 = tl1 + tl2;
    T cl3 = c.l + cl2;
    return algorithms::FastTwoSum(c.h, cl3);
    */

}

// ################################################################
// ##  Building Blocks  ###########################################
// ################################################################

module TwoSum {
    clock aclk

    input float a'0
    input float b'0

    output float rh
    output float rl

    dspfp32_add#(D_LATENCY: 0, C_LATENCY: 0) x0
    dspfp32_d_sub_c#(D_LATENCY: 0, C_LATENCY: 1) x1
    dspfp32_c_sub_d#(D_LATENCY: 0, C_LATENCY: 1) x2
    dspfp32_c_sub_d#(D_LATENCY: 0, C_LATENCY: 2) x3
    dspfp32_c_sub_d#(D_LATENCY: 0, C_LATENCY: 3) x4
    dspfp32_add#(D_LATENCY: 0, C_LATENCY: 1) x5

    x0.d = a
    x0.c = b
    float _rh = x0.res
    rh = x0.res
    x1.d = rh
    x1.c = b
    float a1 = x1.res
    x2.d = a1
    x2.c = rh
    float b1 = x2.res
    x3.d = a1
    x3.c = a
    float da = x3.res
    x4.d = b1
    x4.c = b
    float db = x4.res
    x5.d = db
    x5.c = da
    float _rl = x5.res
    rl = x5.res

    /*
    two<T> res;
    res.h = a + b;
    T a1 = res.h - b;
    T b1 = res.h - a1;
    T da = a - a1;
    T db = b - b1;
    res.l = da + db;
    return res;
    */

}

module TwoSum2 {
    clock aclk

    input float a'0
    input float b'0

    output float rh
    output float rl
    output float rhc
    output float rlc

    bool[32] a_bits = ToBits(a)
    int#(FROM: 0, TO: 1 << 8) a_exp = BitsToUInt(a_bits[23+:8])
    bool[32] b_bits = ToBits(b)
    int#(FROM: 0, TO: 1 << 8) b_exp = BitsToUInt(b_bits[23+:8])

    reg bool sel = a_exp >= b_exp

    //                      ++ +C  +D
    bool[7] C_PLUS_D   = 7'b00_110_11
    //                      -+ -C  +PC
    bool[7] PC_MINUS_C = 7'b10_110_10
    //                      +- +PC -D
    bool[7] PC_MINUS_D = 7'b01_111_11
    //                      +- +C  -PC
    bool[7] C_MINUS_PC = 7'b01_110_10
    //                      -+ -PC +M
    bool[7] M_MINUS_PC = 7'b10_111_01

    // rh     = a + b
    // pcout0 = rh
    dspfp32_add_ip#(D_LATENCY: 0, C_LATENCY: 0, FPOP_LATENCY: 0) x0
    x0.d = b
    x0.c = a
    x0.pcin = 0.0
    x0.fpopmode = C_PLUS_D
    float pcout0 = x0.pcout
    rh = x0.fpa_out
    rhc = x0.pcout

    // z      = pcout0 - (sel ? a : b)
    // pcout1 = z
    dspfp32_add_ip#(D_LATENCY: 1, C_LATENCY: 1, FPOP_LATENCY: 0) x1
    x1.d = b
    x1.c = a
    x1.pcin = pcout0
    float _fpa_out1 = x1.fpa_out
    when (sel) {
        x1.fpopmode = PC_MINUS_C
    } else {
        x1.fpopmode = PC_MINUS_D
    }
    float pcout1 = x1.pcout

    // rl = (sel ? b : a) - pcout1
    dspfp32_full#(A_REGS: 0, B_REGS: 0, C_REGS: 2, D_REGS: 0, M_REGS: 2, OP_REGS: 1, ACIN: 0, PCOUT_FPA: 1) dsp2
    bool[7] fpopmode = C_MINUS_PC
    when sel {
        fpopmode = M_MINUS_PC
    }
    dsp2.apply(b, 1.0, a, 0.0, 0.0, pcout1, fpopmode)
    float _t0 = dsp2.acout
    float _t1 = dsp2.fpm_out
    rl = dsp2.fpa_out
    rlc = dsp2.pcout

    /*
    two<T> res;
    bool sel = a_exp > b_exp;
    res.h = a + b;
    T z = res.h - (sel ? a : b);
    res.l = (sel ? b : a) - z;
    return res;
    */

}

module FastTwoSum#(int A_LATENCY) {
    clock aclk

    gen int A0_LATENCY = 0
    gen int A1_LATENCY = A_LATENCY
    if A_LATENCY == 4 {
        A0_LATENCY = 3
        A1_LATENCY = 1
    } else if A_LATENCY == 5 {
        A0_LATENCY = 4
        A1_LATENCY = 1
    } else if A_LATENCY == 6 {
        A0_LATENCY = 4
        A1_LATENCY = 2
    } else if A_LATENCY == 7 {
        A0_LATENCY = 4
        A1_LATENCY = 3
    }

    input float a'-A_LATENCY
    input float b'0
    input float bc'0

    output float rh
    output float rl
    output float rhc
    output float rlc

    float a2
    if A0_LATENCY == 0 {
        dspfp32_add_c_pcin#(C_REGS: A1_LATENCY) dsp0
        dsp0.apply(a, bc)
        rhc = dsp0.pcout
        rh = dsp0.fpa_out
        a2 = a
    } else {
        dspfp32_mul_a_b_add_c_pcin#(A_REGS: A0_LATENCY-2, B_REGS: 0, C_REGS: A1_LATENCY) dsp0
        a2 = dsp0.fpm_out
        dsp0.mul(a, 1.0)
        dsp0.add(a2, bc)
        rhc = dsp0.pcout
        rh = dsp0.fpa_out
    }

    float z
    if A1_LATENCY <= 2 {
        dspfp32_add_nc_pcin#(C_REGS: A1_LATENCY+1) dsp1
        dsp1.apply(a2, rhc)
        z = dsp1.pcout
        float _t0 = dsp1.fpa_out
    } else {
        dspfp32_mac_a_b_pcin#(A_REGS: A1_LATENCY-1, B_REGS: 0) dsp1
        dsp1.apply(a2, -1.0, rhc)
        z = dsp1.pcout
        float _t0 = dsp1.fpa_out
        float _t1 = dsp1.fpm_out
    }

    dspfp32_add_c_npcin#(C_REGS: 2) dsp2
    dsp2.apply(b, z)
    rlc = dsp2.pcout
    rl = dsp2.fpa_out

    /*
        two<T> res;
        res.h = a + b;
        T z = res.h - a;
        res.l = b - z;
        return res;
    */

}

module FastTwoSumB#(int B_REGS) {
    clock aclk

    input float a'0
    input float ac'0
    input float b'-B_REGS

    output float rh
    output float rl
    output float rhc
    output float rlc

    dspfp32_add_c_pcin#(C_REGS: B_REGS) dsp0
    dsp0.apply(b, ac)
    rhc = dsp0.pcout
    rh = dsp0.fpa_out

    dspfp32_add_nc_pcin#(C_REGS: 1) dsp1
    dsp1.apply(a, rhc)
    float z = dsp1.pcout
    float _t0 = dsp1.fpa_out

    if (B_REGS <= 1) {
        dspfp32_add_c_npcin#(C_REGS: B_REGS+2) dsp2
        dsp2.apply(b, z)
        rlc = dsp2.pcout
        rl = dsp2.fpa_out
    } else {
        dspfp32_mac_a_b_npcin#(A_REGS: B_REGS, B_REGS: 0) dsp2
        dsp2.apply(b, 1.0, z)
        float _t1 = dsp2.fpm_out
        rlc = dsp2.pcout
        rl = dsp2.fpa_out
    }

    /*
        two<T> res;
        res.h = a + b;
        T z = res.h - a;
        res.l = b - z;
        return res;
    */

}

module TwoProd {
    clock aclk

    input float a'0
    input float b'0

    output float rh
    output float rl
    output float rhc
    output float rlc

    bool[7] ADD_C_M    = 7'b00_110_01
    bool[7] SUB_M_C    = 7'b10_110_01
    bool[7] ADD_M_PCIN0 = 7'b00_111_01
    bool[7] ADD_M_PCIN1 = 7'b00_111_01
    bool[7] ADD_M_PCIN2 = 7'b00_111_01

    // rh = a * b + 0.0
    dspfp32_full#(A_REGS: 1, B_REGS: 1, C_REGS: 0, D_REGS: 0, M_REGS: 2, OP_REGS: 0, ACIN: 0, PCOUT_FPA: 1) dsp0
    dsp0.apply(a, b, 0.0, 0.0, 0.0, 0.0, ADD_C_M)
    float _t0 = dsp0.fpm_out
    float rh2 = dsp0.fpa_out
    rhc = dsp0.pcout
    float _t2 = dsp0.acout

    Split a1
    a1.x = a
    float a1h = a1.rh
    float a1l = a1.rl

    Split b1
    b1.x = b
    float b1h = b1.rh
    float b1l = b1.rl

    // res.l = ((a1.h * b1.h - res.h) + a1.h * b1.l + a1.l * b1.h) + a1.l * b1.l;

    // tmp0 = a1h * b1h - rh
    dspfp32_full#(A_REGS: 0, B_REGS: 0, C_REGS: 2, D_REGS: 0, M_REGS: 2, OP_REGS: 0, ACIN: 0, PCOUT_FPA: 1) dsp1
    dsp1.apply(a1h, b1h, rh2, 0.0, 0.0, 0.0, SUB_M_C)
    float _t3   = dsp1.fpm_out
    float _t4   = dsp1.fpa_out
    float tmp0 = dsp1.pcout
    float _t5   = dsp1.acout

    // tmp1 = a1h * b1l + tmp0
    dspfp32_full#(A_REGS: 1, B_REGS: 0, C_REGS: 0, D_REGS: 0, M_REGS: 2, OP_REGS: 0, ACIN: 0, PCOUT_FPA: 1) dsp2
    dsp2.apply(a1h, b1l, 0.0, 0.0, 0.0, tmp0, ADD_M_PCIN0)
    float _t6  = dsp2.fpm_out
    float _t7  = dsp2.fpa_out
    float tmp1 = dsp2.pcout
    float _t8  = dsp2.acout

    // tmp2 = a1l * b1h + tmp1
    dspfp32_full_b#(A_REGS: 2, B_REGS: 1, C_REGS: 0, D_REGS: 0, M_REGS: 2, OP_REGS: 0, BCIN: 0, PCOUT_FPA: 1) dsp3
    dsp3.apply(b1h, a1l, 0.0, 0.0, 0.0, 0.0, tmp1, ADD_M_PCIN1)
    float _t9  = dsp3.fpm_out
    float _t10 = dsp3.fpa_out
    float _t11 = dsp3.acout
    float a1lc = dsp3.bcout
    float tmp2 = dsp3.pcout

    // tmp3 = a1l * b1l + tmp2
    dspfp32_full_b#(A_REGS: 2, B_REGS: 1, C_REGS: 0, D_REGS: 0, M_REGS: 2, OP_REGS: 0, BCIN: 1, PCOUT_FPA: 1) dsp4
    dsp4.apply(b1l, 0.0, 0.0, 0.0, 0.0, a1lc, tmp2, ADD_M_PCIN2)
    float _t12  = dsp4.fpm_out
    float rl2   = dsp4.fpa_out
    float _t13  = dsp4.acout
    float _tl4  = dsp4.bcout
    rlc  = dsp4.pcout

    rh = rh2
    rl = rl2

    /*
    two<T> res;
    res.h = a * b;

    two<T> a1 = Split(a);
    two<T> b1 = Split(b);

    // Order must be preserved to ensure the proven error bounds
    res.l = ((a1.h * b1.h - res.h) + a1.h * b1.l + a1.l * b1.h) + a1.l * b1.l;
    return res;
    */
}

module Split {
    clock aclk

    // The number of bits in the mantissa of the underlying floating point type.
    gen int t = 22
    // The number of bits that x2 fits into when splitting x into x1+x2 in algorithms::Split.
    // Calculated as t/2. See Boldo 2006 Algorithm 1 and 2 for details.
    gen int SplitS = t / 2
    // A constant used to split a floating point number into the sum of two floating point numbers.
    // Calculated as β^(s) + 1. See Boldo 2006 Algorithm 1 and 2 for explanations.
    gen int SplitC = pow#(B: 2, E: SplitS) + 1
    int#(FROM: 0, TO: 1 << 32) SplitC2 = SplitC
    float SplitCF = 2049.0

    input float x'0

    output float rh
    output float rl

    bool[7] ADD_C_PCIN = 7'b00_110_10
    bool[7] SUB_M_PCIN = 7'b10_111_01
    bool[7] SUB_C_M    = 7'b01_110_01

    // p = x * SplitC
    // q = x - p
    // xc = x'+2
    dspfp32_full#(A_REGS: 0, B_REGS: 0, C_REGS: 2, D_REGS: 0, M_REGS: 2, OP_REGS: 0, ACIN: 0, PCOUT_FPA: 1) dsp0
    dsp0.apply(x, SplitCF, x, 0.0, 0.0, 0.0, SUB_C_M)
    float p   = dsp0.fpm_out
    float _t0 = dsp0.fpa_out
    float q   = dsp0.pcout
    float xc  = dsp0.acout

    // x1 = pcin(dsp0.p) + c(dsp0.q)
    dspfp32_full#(A_REGS: 1, B_REGS: 0, C_REGS: 1, D_REGS: 0, M_REGS: 2, OP_REGS: 0, ACIN: 1, PCOUT_FPA: 1) dsp1
    dsp1.apply(0.0, 0.0, p, 0.0, xc, q, ADD_C_PCIN)
    float _t1 = dsp1.fpm_out
    float x1  = dsp1.fpa_out
    float x1c = dsp1.pcout
    float xcc = dsp1.acout

    // x2 = acin(xc)*1.0 - pcin(x1)
    dspfp32_full#(A_REGS: 1, B_REGS: 0, C_REGS: 0, D_REGS: 0, M_REGS: 2, OP_REGS: 0, ACIN: 1, PCOUT_FPA: 1) dsp2
    dsp2.apply(0.0, 1.0, 0.0, 0.0, xcc, x1c, SUB_M_PCIN)
    float _t4  = dsp2.fpm_out
    float x2  = dsp2.fpa_out
    float _t5 = dsp2.pcout
    float _t6  = dsp2.acout

    rh = x1
    rl = x2

    /*
    T p = x * SplitC;
    T q = x - p;
    T x1 = p + q;
    T x2 = x - x1;
    return {x1, x2};
    */

}

// ################################################################
// ##  Extern  ####################################################
// ################################################################

extern module dspfp32_add_ip #(int D_LATENCY, int C_LATENCY, int FPOP_LATENCY) {
    clock aclk

    assert#(C: 0 <= D_LATENCY & D_LATENCY <= 1)
    assert#(C: 0 <= C_LATENCY & C_LATENCY <= 3)
    assert#(C: 0 <= FPOP_LATENCY & FPOP_LATENCY <= 3)

    input float d'-D_LATENCY
    input float c'-C_LATENCY
    input float pcin'0
    input bool[7] fpopmode'-FPOP_LATENCY
    output float fpa_out'1
    output float pcout'1
}

module dspfp32_delay#(int DELAY) {
    clock aclk

    interface dspfp32_delay: float x'-(DELAY-1) -> float y'1 {
        y = x
        /*if DELAY <= 4 {
            dspfp32_add_c_d#(D_REGS: 0, C_REGS: DELAY-1) dsp0
            dsp0.apply(x, 0.0)
            float _t0 = dsp0.pcout
            y = dsp0.fpa_out
        } else {
            dspfp32_mac_a_b_c#(A_REGS: 2, B_REGS: 0, C_REGS: 0) dsp0
            dsp0.apply(x, 1.0, 0.0)
            float _t1 = dsp0.pcout
            float _t2 = dsp0.fpm_out
            y = dsp0.fpa_out
        }*/
    }

}

module dspfp32_add #(int D_LATENCY, int C_LATENCY) {
    clock aclk

    assert#(C: C_LATENCY <= 3)
    
    input float d'-D_LATENCY
    input float c'-C_LATENCY
    output float res

    dspfp32_add_ip#(D_LATENCY, C_LATENCY, FPOP_LATENCY: 0) ip
    ip.d = d
    ip.c = c
    ip.pcin = 0.0
    //               ++ +C  +D
    ip.fpopmode = 7'b00_110_11

    float _t0 = ip.pcout // Tie off
    res = ip.fpa_out

}

module dspfp32_c_sub_d #(int D_LATENCY, int C_LATENCY) {
    clock aclk
    
    input float d'-D_LATENCY
    input float c'-C_LATENCY
    output float res

    dspfp32_add_ip#(D_LATENCY, C_LATENCY, FPOP_LATENCY: 0) ip
    ip.d = d
    ip.c = c
    ip.pcin = 0.0
    //               +- +C  -D
    ip.fpopmode = 7'b01_110_11

    float _t0 = ip.pcout // Tie off
    res = ip.fpa_out

}

module dspfp32_d_sub_c #(int D_LATENCY, int C_LATENCY) {
    clock aclk
    
    input float d'-D_LATENCY
    input float c'-C_LATENCY
    output float res

    dspfp32_add_ip#(D_LATENCY, C_LATENCY, FPOP_LATENCY: 0) ip
    ip.d = d
    ip.c = c
    ip.pcin = 0.0
    //               -+ -C  +D
    ip.fpopmode = 7'b10_110_11

    float _t0 = ip.pcout // Tie off
    res = ip.fpa_out

}

module dspfp32_add_c_d#(int C_REGS, int D_REGS) {
    clock aclk

    output float fpa_out'1
    output float pcout'1

    dspfp32_full_ip#(A_REGS: 0, B_REGS: 0, C_REGS: C_REGS, D_REGS: D_REGS, M_REGS: 0, OP_REGS: 0, ACIN: 0, BCIN: 0, PCOUT_FPA: 1) ip

    interface apply: float c'-C_REGS, float d'-D_REGS {
        ip.a = 0.0
        ip.b = 0.0
        ip.c = c
        ip.d = d
        ip.pcin = 0.0
        //               ++ +C  +D
        ip.fpopmode = 7'b00_110_11
    }

    fpa_out = ip.fpa_out
    pcout = ip.pcout

}

module dspfp32_add_c_pcin#(int C_REGS) {
    clock aclk

    output float fpa_out'1
    output float pcout'1

    dspfp32_full_ip#(A_REGS: 0, B_REGS: 0, C_REGS: C_REGS, D_REGS: 0, M_REGS: 0, OP_REGS: 0, ACIN: 0, BCIN: 0, PCOUT_FPA: 1) ip

    interface apply: float c'-C_REGS, float pcin'0 {
        ip.a = 0.0
        ip.b = 0.0
        ip.c = c
        ip.d = 0.0
        ip.pcin = pcin
        //               ++ +C  +PCIN
        ip.fpopmode = 7'b00_110_10
    }

    fpa_out = ip.fpa_out
    pcout = ip.pcout

}

module dspfp32_add_nc_pcin#(int C_REGS) {
    clock aclk

    output float fpa_out'1
    output float pcout'1

    dspfp32_full_ip#(A_REGS: 0, B_REGS: 0, C_REGS: C_REGS, D_REGS: 0, M_REGS: 0, OP_REGS: 0, ACIN: 0, BCIN: 0, PCOUT_FPA: 1) ip

    interface apply: float c'-C_REGS, float pcin'0 {
        ip.a = 0.0
        ip.b = 0.0
        ip.c = c
        ip.d = 0.0
        ip.pcin = pcin
        //               -+ -C  +PCIN
        ip.fpopmode = 7'b10_110_10
    }

    fpa_out = ip.fpa_out
    pcout = ip.pcout

}

module dspfp32_add_c_npcin#(int C_REGS) {
    clock aclk

    output float fpa_out'1
    output float pcout'1

    dspfp32_full_ip#(A_REGS: 0, B_REGS: 0, C_REGS: C_REGS, D_REGS: 0, M_REGS: 0, OP_REGS: 0, ACIN: 0, BCIN: 0, PCOUT_FPA: 1) ip

    interface apply: float c'-C_REGS, float pcin'0 {
        ip.a = 0.0
        ip.b = 0.0
        ip.c = c
        ip.d = 0.0
        ip.pcin = pcin
        //               -+ +C  -PCIN
        ip.fpopmode = 7'b01_110_10
    }

    fpa_out = ip.fpa_out
    pcout = ip.pcout

}

module dspfp32_mul_a_b#(int A_REGS, int B_REGS) {
    clock aclk

    output float fpm_out'0
    output float pcout'0

    dspfp32_full_ip#(A_REGS: A_REGS, B_REGS: B_REGS, C_REGS: 0, D_REGS: 0, M_REGS: 2, OP_REGS: 0, ACIN: 0, BCIN: 0, PCOUT_FPA: 0) ip

    interface apply: float a'-(A_REGS+2), float b'-(B_REGS+2) {
        ip.a = a
        ip.b = b
        ip.c = 0.0
        ip.pcin = 0.0
        ip.fpopmode = 7'b00_000_00
    }
    
    fpm_out = ip.fpm_out
    pcout = ip.pcout

}

module dspfp32_mac_a_b_pcin#(int A_REGS, int B_REGS) {
    clock aclk

    output float fpm_out'0
    output float fpa_out'1
    output float pcout'1

    dspfp32_full_ip#(A_REGS: A_REGS, B_REGS: B_REGS, C_REGS: 0, D_REGS: 0, M_REGS: 2, OP_REGS: 0, ACIN: 0, BCIN: 0, PCOUT_FPA: 1) ip

    interface apply: float a'-(A_REGS+2), float b'-(B_REGS+2), float pcin'0 {
        ip.a = a
        ip.b = b
        ip.c = 0.0
        ip.d = 0.0
        ip.pcin = pcin
        //               ++ +PCIN +M
        ip.fpopmode = 7'b00_111_01
    }
    
    fpm_out = ip.fpm_out
    fpa_out = ip.fpa_out
    pcout = ip.pcout

}

module dspfp32_mac_a_b_npcin#(int A_REGS, int B_REGS) {
    clock aclk

    output float fpm_out'0
    output float fpa_out'1
    output float pcout'1

    dspfp32_full_ip#(A_REGS: A_REGS, B_REGS: B_REGS, C_REGS: 0, D_REGS: 0, M_REGS: 2, OP_REGS: 0, ACIN: 0, BCIN: 0, PCOUT_FPA: 1) ip

    interface apply: float a'-(A_REGS+2), float b'-(B_REGS+2), float pcin'0 {
        ip.a = a
        ip.b = b
        ip.c = 0.0
        ip.d = 0.0
        ip.pcin = pcin
        //               -+ -PCIN +M
        ip.fpopmode = 7'b10_111_01
    }
    
    fpm_out = ip.fpm_out
    fpa_out = ip.fpa_out
    pcout = ip.pcout

}

module dspfp32_mac_a_b_c#(int A_REGS, int B_REGS, int C_REGS) {
    clock aclk

    output float fpm_out'0
    output float fpa_out'1
    output float pcout'1

    dspfp32_full_ip#(A_REGS: A_REGS, B_REGS: B_REGS, C_REGS: C_REGS, D_REGS: 0, M_REGS: 2, OP_REGS: 0, ACIN: 0, BCIN: 0, PCOUT_FPA: 1) ip

    interface apply: float a'-(A_REGS+2), float b'-(B_REGS+2), float c'C_REGS {
        ip.a = a
        ip.b = b
        ip.c = c
        ip.d = 0.0
        ip.pcin = 0.0
        //               ++ +C  +M
        ip.fpopmode = 7'b00_110_01
    }
    
    fpm_out = ip.fpm_out
    fpa_out = ip.fpa_out
    pcout = ip.pcout
}

extern module dspfp32_full_ip #(int A_REGS, int B_REGS, int C_REGS, int D_REGS, int M_REGS, int OP_REGS, int ACIN, int BCIN, int PCOUT_FPA) {
    clock aclk
    
    assert#(C: 0 <= A_REGS & A_REGS <= 2)
    assert#(C: 0 <= B_REGS & B_REGS <= 1)
    assert#(C: 0 <= C_REGS & C_REGS <= 3)
    assert#(C: 0 <= D_REGS & D_REGS <= 1)
    assert#(C: 0 <= M_REGS & M_REGS <= 2)
    assert#(C: 0 <= OP_REGS & OP_REGS <= 3)
    assert#(C: 0 <= PCOUT_FPA & PCOUT_FPA <= 1)

    input float a'-(A_REGS+M_REGS)
    input float b'-(B_REGS+M_REGS)
    input float c'-C_REGS
    input float d'-D_REGS
    input float acin'-(A_REGS+M_REGS)
    input float bcin'-(B_REGS+M_REGS)
    input float pcin'0
    input bool[7] fpopmode'-OP_REGS
    output float fpm_out'0
    output float fpa_out'1
    output float acout'-M_REGS
    output float bcout'-M_REGS
    output float pcout'PCOUT_FPA
}

module dspfp32_full #(int A_REGS, int B_REGS, int C_REGS, int D_REGS, int M_REGS, int OP_REGS, int ACIN, int PCOUT_FPA) {
    clock aclk

    output float fpm_out'0
    output float fpa_out'1
    output float acout'-M_REGS
    output float pcout'PCOUT_FPA

    dspfp32_full_ip#(A_REGS, B_REGS, C_REGS, D_REGS, M_REGS, OP_REGS, ACIN: ACIN, BCIN: 0, PCOUT_FPA) ip

    interface apply: float a'-(A_REGS+M_REGS), float b'-(B_REGS+M_REGS), float c'-C_REGS, float d'-D_REGS,
                     float acin'-(A_REGS+M_REGS), float pcin'0, bool[7] fpopmode'-OP_REGS {
        ip.a = a
        ip.b = b
        ip.c = c
        ip.d = d
        ip.acin = acin
        ip.bcin = 0.0
        ip.pcin = pcin
        ip.fpopmode = fpopmode
    }

    fpm_out = ip.fpm_out
    fpa_out = ip.fpa_out
    acout = ip.acout
    float _bcout = ip.bcout
    pcout = ip.pcout

}

module dspfp32_full_b #(int A_REGS, int B_REGS, int C_REGS, int D_REGS, int M_REGS, int OP_REGS, int BCIN, int PCOUT_FPA) {
    clock aclk

    output float fpm_out'0
    output float fpa_out'1
    output float acout'-M_REGS
    output float bcout'-M_REGS
    output float pcout'PCOUT_FPA

    dspfp32_full_ip#(A_REGS, B_REGS, C_REGS, D_REGS, M_REGS, OP_REGS, ACIN: 0, BCIN: BCIN, PCOUT_FPA) ip

    interface apply: float a'-(A_REGS+M_REGS), float b'-(B_REGS+M_REGS), float c'-C_REGS, float d'-D_REGS,
                     float acin'-(A_REGS+M_REGS), float bcin'-(B_REGS+M_REGS), float pcin'0, bool[7] fpopmode'-OP_REGS {
        ip.a = a
        ip.b = b
        ip.c = c
        ip.d = d
        ip.acin = acin
        ip.bcin = bcin
        ip.pcin = pcin
        ip.fpopmode = fpopmode
    }

    fpm_out = ip.fpm_out
    fpa_out = ip.fpa_out
    pcout = ip.pcout
    bcout = ip.bcout
    acout = ip.acout

}

extern module dspfp32_mul_add_ip #(int A_REGS, int B_REGS, int C_REGS, int D_REGS, int M_REGS, int OP_REGS, int ACIN, int BCIN, int PCOUT_FPA) {

    assert#(C: 0 <= A_REGS & A_REGS <= 2)
    assert#(C: 0 <= B_REGS & B_REGS <= 1)
    assert#(C: 0 <= C_REGS & C_REGS <= 3)
    assert#(C: 0 <= D_REGS & D_REGS <= 1)
    assert#(C: 0 <= M_REGS & M_REGS <= 2)
    assert#(C: 0 <= OP_REGS & OP_REGS <= 3)
    assert#(C: 0 <= PCOUT_FPA & PCOUT_FPA <= 1)

    clock aclk
    input float a'-(A_REGS+M_REGS)
    input float b'-(B_REGS+M_REGS)
    input float acin'-(A_REGS+M_REGS)
    input float bcin'-(B_REGS+M_REGS)
    output float fpm_out'0
    output float acout'-M_REGS
    output float bcout'-M_REGS

    domain bclk
    input float c'-C_REGS
    input float d'-D_REGS
    input float pcin'0
    input bool[7] fpopmode'-OP_REGS
    output float fpa_out'1
    output float pcout'PCOUT_FPA
}

module dspfp32_mul_a_b_add_c_d#(int A_REGS, int B_REGS, int C_REGS, int D_REGS) {

    dspfp32_mul_add_ip#(A_REGS: A_REGS, B_REGS: B_REGS, C_REGS: C_REGS, D_REGS: D_REGS, M_REGS: 2, OP_REGS: 0, ACIN: 0, BCIN: 0, PCOUT_FPA: 1) ip

    clock aclk
    output float fpm_out'0

    interface mul: float a'-(A_REGS+2), float b'-(B_REGS+2) {
        ip.a = a
        ip.b = b
        ip.acin = 0.0
        ip.bcin = 0.0
        float _acout = ip.acout
        float _bcout = ip.bcout
    }
    fpm_out = ip.fpm_out

    domain bclk
    output float fpa_out'1
    output float pcout'1

    interface add: float c'-C_REGS, float d'-D_REGS {
        ip.c = c
        ip.d = d
        ip.pcin = 0.0
        //               ++ +C  +D
        ip.fpopmode = 7'b00_110_11
    }
    fpa_out = ip.fpa_out
    pcout = ip.pcout

}

module dspfp32_mul_a_b_add_c_pcin#(int A_REGS, int B_REGS, int C_REGS) {

    dspfp32_mul_add_ip#(A_REGS: A_REGS, B_REGS: B_REGS, C_REGS: C_REGS, D_REGS: 0, M_REGS: 2, OP_REGS: 0, ACIN: 0, BCIN: 0, PCOUT_FPA: 1) ip

    clock aclk
    output float fpm_out'0

    interface mul: float a'-(A_REGS+2), float b'-(B_REGS+2) {
        ip.a = a
        ip.b = b
        ip.acin = 0.0
        ip.bcin = 0.0
        float _acout = ip.acout
        float _bcout = ip.bcout
    }
    fpm_out = ip.fpm_out

    domain bclk
    output float fpa_out'1
    output float pcout'1

    interface add: float c'-C_REGS, float pcin'0 {
        ip.c = c
        ip.d = 0.0
        ip.pcin = pcin
        //               ++ +C  +PC
        ip.fpopmode = 7'b00_110_10
    }
    fpa_out = ip.fpa_out
    pcout = ip.pcout

}
