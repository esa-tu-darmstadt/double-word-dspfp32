
module SUS_DWTimesDW_Fast {
    clock aclk

    gen int TYPE = 7

    output bool                               saxis_a_tready'0 = true
    input  bool                               saxis_a_tvalid'0
    input  bool[128]                          saxis_a_tdata'0
    input  bool[16]                           saxis_a_tkeep'0
    input  bool                               saxis_a_tlast'0

    output bool                               saxis_b_tready'0 = true
    input  bool                               saxis_b_tvalid'0
    input  bool[128]                          saxis_b_tdata'0
    input  bool[16]                           saxis_b_tkeep'0
    input  bool                               saxis_b_tlast'0

    input  bool                               maxis_tready'0
    output bool                               maxis_tvalid'0 = true
    output bool[128]                          maxis_tdata
    output bool[16]                           maxis_tkeep'0 = FromBits(16'b0)
    output bool                               maxis_tlast'0 = false

    bool      _saxis_a_tvalid = saxis_a_tvalid
    bool[16]  _saxis_a_tkeep  = saxis_a_tkeep
    bool      _saxis_a_tlast  = saxis_a_tlast
    bool      _saxis_b_tvalid = saxis_b_tvalid
    bool[16]  _saxis_b_tkeep  = saxis_b_tkeep
    bool      _saxis_b_tlast  = saxis_b_tlast
    bool      _maxis_tready   = maxis_tready

    if TYPE == 0 {
        FPPlusFP inst
        inst.x = FromBits(saxis_a_tdata[0+:32])
        inst.y = FromBits(saxis_b_tdata[0+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    } else if TYPE == 1 {
        DWPlusFP inst
        inst.xh = FromBits(saxis_a_tdata[0+:32])
        inst.xl = FromBits(saxis_a_tdata[32+:32])
        inst.y = FromBits(saxis_b_tdata[0+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    } else if TYPE == 2 {
        DWPlusDW_Sloppy inst
        inst.xh = FromBits(saxis_a_tdata[0+:32])
        inst.xl = FromBits(saxis_a_tdata[32+:32])
        inst.yh = FromBits(saxis_b_tdata[0+:32])
        inst.yl = FromBits(saxis_b_tdata[32+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    } else if TYPE == 3 {
        DWPlusDW_Accurate inst
        inst.xh = FromBits(saxis_a_tdata[0+:32])
        inst.xl = FromBits(saxis_a_tdata[32+:32])
        inst.yh = FromBits(saxis_b_tdata[0+:32])
        inst.yl = FromBits(saxis_b_tdata[32+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    } else if TYPE == 4 {
        FPTimesFP inst
        inst.x = FromBits(saxis_a_tdata[0+:32])
        inst.y = FromBits(saxis_b_tdata[0+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    } else if TYPE == 5 {
        DWTimesFP_Fast inst
        inst.xh = FromBits(saxis_a_tdata[0+:32])
        inst.xl = FromBits(saxis_a_tdata[32+:32])
        inst.y = FromBits(saxis_b_tdata[0+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    } else if TYPE == 6 {
        DWTimesFP_Accurate inst
        inst.xh = FromBits(saxis_a_tdata[0+:32])
        inst.xl = FromBits(saxis_a_tdata[32+:32])
        inst.y = FromBits(saxis_b_tdata[0+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    } else if TYPE == 7 {
        DWTimesDW_Fast inst
        inst.xh = FromBits(saxis_a_tdata[0+:32])
        inst.xl = FromBits(saxis_a_tdata[32+:32])
        inst.yh = FromBits(saxis_b_tdata[0+:32])
        inst.yl = FromBits(saxis_b_tdata[32+:32])
        maxis_tdata[0+:32]  = ToBits(inst.rh)
        maxis_tdata[32+:32] = ToBits(inst.rl)
        maxis_tdata[64+:32] = ToBits(0.0)
        maxis_tdata[96+:32] = ToBits(0.0)
    }

}

module testbench {

    input float[20] vals'0
    output bool[8] valids

    FPPlusFP inst0
    inst0.x = vals[0]
    inst0.y = vals[2]
    bool valid0 = BitsToUInt(ToBits(vals[4])) == BitsToUInt(ToBits(inst0.rh)) & BitsToUInt(ToBits(vals[5])) == BitsToUInt(ToBits(inst0.rl))
    valids[0] = valid0

    DWPlusFP inst1
    inst1.xh = vals[0]
    inst1.xl = vals[1]
    inst1.y = vals[2]
    bool valid1 = BitsToUInt(ToBits(vals[6])) == BitsToUInt(ToBits(inst1.rh)) & BitsToUInt(ToBits(vals[7])) == BitsToUInt(ToBits(inst1.rl))
    valids[1] = valid1

    DWPlusDW_Sloppy inst2
    inst2.xh = vals[0]
    inst2.xl = vals[1]
    inst2.yh = vals[2]
    inst2.yl = vals[3]
    bool valid2 = BitsToUInt(ToBits(vals[8])) == BitsToUInt(ToBits(inst2.rh)) & BitsToUInt(ToBits(vals[9])) == BitsToUInt(ToBits(inst2.rl))
    valids[2] = valid2

    DWPlusDW_Accurate inst3
    inst3.xh = vals[0]
    inst3.xl = vals[1]
    inst3.yh = vals[2]
    inst3.yl = vals[3]
    bool valid3 = BitsToUInt(ToBits(vals[10])) == BitsToUInt(ToBits(inst3.rh)) & BitsToUInt(ToBits(vals[11])) == BitsToUInt(ToBits(inst3.rl))
    valids[3] = valid3

    FPTimesFP inst4
    inst4.x = vals[0]
    inst4.y = vals[2]
    bool valid4 = BitsToUInt(ToBits(vals[12])) == BitsToUInt(ToBits(inst4.rh)) & BitsToUInt(ToBits(vals[13])) == BitsToUInt(ToBits(inst4.rl))
    valids[4] = valid4

    DWTimesFP_Fast inst5
    inst5.xh = vals[0]
    inst5.xl = vals[1]
    inst5.y = vals[2]
    bool valid5 = BitsToUInt(ToBits(vals[14])) == BitsToUInt(ToBits(inst5.rh)) & BitsToUInt(ToBits(vals[15])) == BitsToUInt(ToBits(inst5.rl))
    valids[5] = valid5

    DWTimesFP_Accurate inst6
    inst6.xh = vals[0]
    inst6.xl = vals[1]
    inst6.y = vals[2]
    bool valid6 = BitsToUInt(ToBits(vals[16])) == BitsToUInt(ToBits(inst6.rh)) & BitsToUInt(ToBits(vals[17])) == BitsToUInt(ToBits(inst6.rl))
    valids[6] = valid6

    DWTimesDW_Fast inst7
    inst7.xh = vals[0]
    inst7.xl = vals[1]
    inst7.yh = vals[2]
    inst7.yl = vals[3]
    bool valid7 = BitsToUInt(ToBits(vals[18])) == BitsToUInt(ToBits(inst7.rh)) & BitsToUInt(ToBits(vals[19])) == BitsToUInt(ToBits(inst7.rl))
    valids[7] = valid7

}

// ################################################################
// ##  Algorithms  ################################################
// ################################################################

module FPPlusFP {
    clock aclk

    input float x'0
    input float y'0

    output float rh
    output float rl

    TwoSum#(LATE_RH: true) r
    r.a = x
    r.b = y

    rh = r.rh
    rl = r.rl
}

module DWPlusFP {
    clock aclk

    input float xh'0
    input float xl'0
    input float y'0

    output float rh
    output float rl

    TwoSum#(LATE_RH: false) s
    s.a = xh
    s.b = y
    float sh = s.rh
    float sl = s.rl
    float slc = s.rlc

    dspfp32_mac_a_b_pcin#(A_REGS: 2, B_REGS: 0, M_REGS: 2) dsp0
    dsp0.apply(xl, 1.0, slc)
    float v = dsp0.fpa_out
    float vc = dsp0.pcout

    FastTwoSum#(A_LATENCY: 3, LATE_RH: true) r
    r.a = sh
    r.b = v
    r.bc = vc

    /*
    two<T> s = algorithms::TwoSum(x.h, y);
    T v = x.l + s.l;
    return algorithms::FastTwoSum(s.h, v);
    */

    rh = r.rh
    rl = r.rl
}

module DWPlusDW_Sloppy {
    clock aclk

    input float xh'0
    input float xl'0
    input float yh'0
    input float yl'0

    output float rh
    output float rl

    TwoSum#(LATE_RH: false) s
    s.a = xh
    s.b = yh
    float sh   = s.rh
    float _shc = s.rhc
    float _sl  = s.rl
    float slc  = s.rlc

    dspfp32_add_c_d#(C_REGS: 1, D_REGS: 1) dsp0
    dsp0.apply(xl, yl)
    float v = dsp0.fpa_out
    float _vc = dsp0.pcout

    dspfp32_add_c_pcin#(C_REGS: 2) dsp1
    dsp1.apply(v, slc)
    float w = dsp1.fpa_out
    float wc = dsp1.pcout

    FastTwoSum#(A_LATENCY: 3, LATE_RH: true) r
    r.a = sh
    r.b = w
    r.bc = wc
    float _rhc = r.rhc
    float _rlc = r.rlc

    /*
    two<T> s = algorithms::TwoSum(x.h, y.h);
    T v = x.l + y.l;
    T w = s.l + v;
    return algorithms::FastTwoSum(s.h, w);
    */

    rh = r.rh
    rl = r.rl
}

module DWPlusDW_Accurate {
    clock aclk

    input float xh'0
    input float xl'0
    input float yh'0
    input float yl'0

    output float rh
    output float rl

    TwoSum#(LATE_RH: false) s
    s.a = xh
    s.b = yh
    float sh = s.rh
    float sl = s.rl
    float _shc = s.rhc
    float slc = s.rlc

    TwoSum#(LATE_RH: false) t
    t.a = xl
    t.b = yl
    float th = t.rh
    float tl = t.rl
    float _thc = t.rhc
    float _tlc = t.rlc

    dspfp32_add_c_pcin#(C_REGS: 2) dsp0
    dsp0.apply(th, slc)
    float c = dsp0.fpa_out
    float cc = dsp0.pcout

    FastTwoSum#(A_LATENCY: 3, LATE_RH: false) v
    v.a = sh
    v.b = c
    v.bc = cc
    float vh = v.rh
    float vl = v.rlc

    dspfp32_mac_a_b_pcin#(A_REGS: 2, B_REGS: 0, M_REGS: 2) dsp1
    dsp1.apply(tl, 1.0, vl)
    float w = dsp1.fpa_out
    float _t1 = dsp1.fpm_out
    float wc = dsp1.pcout

    FastTwoSum#(A_LATENCY: 3, LATE_RH: true) r
    r.a = vh
    r.b = w
    r.bc = wc

    /*
    two<T> s = algorithms::TwoSum(x.h, y.h);
    two<T> t = algorithms::TwoSum(x.l, y.l);
    T c = s.l + t.h;
    two<T> v = algorithms::FastTwoSum(s.h, c);
    T w = t.l + v.l;
    return algorithms::FastTwoSum(v.h, w);
    */

    rh = r.rh
    rl = r.rl
}

module FPTimesFP {
    clock aclk

    input float x'0
    input float y'0

    output float rh
    output float rl

    TwoProd_LATE_RH r
    r.a = x
    r.b = y

    rh = r.rh_late
    rl = r.rl
}

module DWTimesFP_Fast {
    clock aclk

    input float xh'0
    input float xl'0
    input float y'0

    output float rh
    output float rl

    TwoProd_LATE_RH c
    c.a = xh
    c.b = y
    float ch = c.rh_late
    float cl = c.rlc

    // merged with inline FastTwoSum
    // cl2 = x.l * y
    dspfp32_mul_a_b_pcout_add_c_npcin#(A_REGS: 1, B_REGS: 1, C_REGS: 2, M_REGS: 2) dsp0
    dsp0.mul(xl, y)
    float cl2 = dsp0.fpm_out

    // cl3 = c.l + cl2
    dspfp32_mul_a_b_add_c_pcin#(A_REGS: 2, B_REGS: 0, C_REGS: 3, M_REGS: 2) dsp2
    float cl2m = dsp2.fpm_out
    dsp2.mul(cl2, 1.0)
    dsp2.add(cl2m, cl)
    float cl3c = dsp2.pcout
    float cl3 = dsp2.fpa_out

    // ################################
    // ##  inline FastTwoSum  #########
    float f_a = ch
    float f_b = cl3
    float f_bc = cl3c

    // f_rh = f_a + f_b
    dspfp32_add_c_pcin#(C_REGS: 1) fa_dsp0
    fa_dsp0.apply(f_a, f_bc)
    float f_rhc = fa_dsp0.pcout
    float f_rh  = fa_dsp0.fpa_out

    // f_z = f_rh - f_a
    dspfp32_mul_a_b_add_nc_pcin#(A_REGS: 1, B_REGS: 0, C_REGS: 2, M_REGS: 1) fa_dsp1
    fa_dsp1.add(f_a, f_rhc)
    float f_z = fa_dsp1.pcout
    // use free multiplier for delay
    fa_dsp1.mul(f_rh, 1.0)
    float f_rh2 = fa_dsp1.fpm_out

    // f_rl = f_b - f_z
    dsp0.add(f_b, f_z)
    float f_rl = dsp0.fpa_out
    // ################################

    rh = f_rh2
    rl = f_rl

    /*
    two<T> c = algorithms::TwoProd(x.h, y);
    T cl2 = x.l * y;
    T cl3 = c.l + cl2;
    return algorithms::FastTwoSum(c.h, cl3);
    */

}

module DWTimesFP_Accurate {
    clock aclk

    input float xh'0
    input float xl'0
    input float y'0

    output float rh
    output float rl

    TwoProd c
    c.a = xh
    c.b = y
    float ch = c.rh
    float cl = c.rlc

    dspfp32_mul_a_b_add_c_d#(A_REGS: 1, B_REGS: 1, C_REGS: 1, D_REGS: 1, M_REGS: 2) fts_dsp0
    fts_dsp0.mul(xl, y)
    float cl2 = fts_dsp0.fpm_out
    // ################################
    // ##  inline FastTwoSum  #########
    float fts_a  = ch
    float fts_b  = cl2
    fts_dsp0.add(fts_b, fts_a)
    float fts_rhc = fts_dsp0.pcout
    float fts_rh  = fts_dsp0.fpa_out

    dspfp32_add_nc_pcin#(C_REGS: 2) fts_dsp1
    fts_dsp1.apply(fts_a, fts_rhc)
    float fts_z   = fts_dsp1.pcout
    float _fts_t0 = fts_dsp1.fpa_out

    dspfp32_add_c_npcin#(C_REGS: 3) fts_dsp2
    fts_dsp2.apply(fts_b, fts_z)
    float _fts_rlc = fts_dsp2.pcout
    float fts_rl   = fts_dsp2.fpa_out
    // ################################
    float th = fts_rh
    float tl = fts_rl

    dspfp32_add_c_pcin#(C_REGS: 3) dsp1
    dsp1.apply(tl, cl)
    float tl2 = dsp1.fpa_out
    float tl2c = dsp1.pcout

    FastTwoSum#(A_LATENCY: 6, LATE_RH: true) r
    r.a = th
    r.b = tl2
    r.bc = tl2c
    float _rh = r.rh
    float _rl = r.rl

    rh = _rh
    rl = _rl

    /*
    two<T> c = algorithms::TwoProd(x.h, y);
    T cl2 = x.l * y;
    two<T> t = algorithms::FastTwoSum(c.h, cl2);
    T tl2 = t.l + c.l;
    return algorithms::FastTwoSum(t.h, tl2);
    */

}

module DWTimesDW_Fast {
    clock aclk

    input float xh'0
    input float xl'0
    input float yh'0
    input float yl'0

    output float rh
    output float rl

    TwoProd_LATE_RH c
    c.a = xh
    c.b = yh
    float ch = c.rh_late
    float cl = c.rlc

    // merged with inline FastTwoSum
    // tl1 = x.h * y.l
    dspfp32_mul_a_b_pcout_add_c_npcin#(A_REGS: 1, B_REGS: 1, C_REGS: 2, M_REGS: 2) dsp0
    dsp0.mul(xh, yl)
    float tl1 = dsp0.pcout

    // tl2 = x.l * y.h
    // cl2 = tl1 + tl2
    dspfp32_mac_a_b_pcin#(A_REGS: 1, B_REGS: 1, M_REGS: 2) dsp1
    dsp1.apply(xl, yh, tl1)
    float _tl2 = dsp1.fpm_out
    float cl2 = dsp1.fpa_out

    // cl3 = c.l + cl2
    dspfp32_mul_a_b_add_c_pcin#(A_REGS: 2, B_REGS: 0, C_REGS: 2, M_REGS: 2) dsp2
    float cl2m = dsp2.fpm_out
    dsp2.mul(cl2, 1.0)
    dsp2.add(cl2m, cl)
    float cl3c = dsp2.pcout
    float cl3  = dsp2.fpa_out

    // ################################
    // ##  inline FastTwoSum  #########
    float f_a = ch
    float f_b = cl3
    float f_bc = cl3c

    // f_rh = f_a + f_b
    dspfp32_add_c_pcin#(C_REGS: 1) fa_dsp0
    fa_dsp0.apply(f_a, f_bc)
    float f_rhc = fa_dsp0.pcout
    float f_rh  = fa_dsp0.fpa_out

    // f_z = f_rh - f_a
    dspfp32_mul_a_b_add_nc_pcin#(A_REGS: 1, B_REGS: 0, C_REGS: 2, M_REGS: 1) fa_dsp1
    fa_dsp1.add(f_a, f_rhc)
    float f_z = fa_dsp1.pcout
    // use free multiplier for delay
    fa_dsp1.mul(f_rh, 1.0)
    float f_rh2 = fa_dsp1.fpm_out

    // f_rl = f_b - f_z
    dsp0.add(f_b, f_z)
    float f_rl = dsp0.fpa_out
    // ################################

    rh = f_rh2
    rl = f_rl

    /*
    two<T> c = algorithms::TwoProd(x.h, y.h);
    T tl1 = x.h * y.l;
    T tl2 = x.l * y.h;
    T cl2 = tl1 + tl2;
    T cl3 = c.l + cl2;
    return algorithms::FastTwoSum(c.h, cl3);
    */

}

// ################################################################
// ##  Building Blocks  ###########################################
// ################################################################

module TwoSum#(bool LATE_RH) {
    clock aclk

    input float a'0
    input float b'0

    output float rh
    output float rl
    output float rhc
    output float rlc

    bool[32] a_bits = ToBits(a)
    int#(FROM: 0, TO: 1 << 8) a_exp = BitsToUInt(a_bits[23+:8])
    bool[32] b_bits = ToBits(b)
    int#(FROM: 0, TO: 1 << 8) b_exp = BitsToUInt(b_bits[23+:8])

    reg bool sel = a_exp >= b_exp

    //                      -+ -C  +PC
    gen bool[7] PC_MINUS_C = 7'b10_110_10
    //                      +- +PC -M
    gen bool[7] PC_MINUS_M = 7'b01_111_01
    //                      +- +C  -PC
    gen bool[7] C_MINUS_PC = 7'b01_110_10
    //                      -+ -PC +M
    gen bool[7] M_MINUS_PC = 7'b10_111_01

    // rh     = a + b
    // pcout0 = rh
    float pcout0
    if !LATE_RH {
        dspfp32_add_c_d#(C_REGS: 1, D_REGS: 1) dsp0
        dsp0.apply(a, b)
        pcout0 = dsp0.pcout
        rh = dsp0.fpa_out
        rhc = dsp0.pcout
    } else {
        dspfp32_mul_a_b_add_c_d#(A_REGS: 1, B_REGS: 0, C_REGS: 1, D_REGS: 1, M_REGS: 1) dsp0
        dsp0.add(a, b)
        pcout0 = dsp0.pcout
        float rh1 = dsp0.fpa_out
        rhc = dsp0.pcout
        dsp0.mul(rh1, 1.0)
        rh = dsp0.fpm_out
    }

    // z      = pcout0 - (sel ? a : b)
    // pcout1 = z
    dspfp32_mac_a_b_add_c_pcin_op#(A_REGS: 1, B_REGS: 0, C_REGS: 2, M_REGS: 1, OP_REGS: 1) dsp1
    bool[7] fpopmode0 = PC_MINUS_C
    when sel {
        fpopmode0 = PC_MINUS_M
    }
    dsp1.apply(a, 1.0, b, pcout0, fpopmode0)
    float _fpm_out1 = dsp1.fpm_out
    float _fpa_out1 = dsp1.fpa_out
    float pcout1 = dsp1.pcout

    // rl = (sel ? b : a) - pcout1
    dspfp32_mac_a_b_add_c_pcin_op#(A_REGS: 1, B_REGS: 0, C_REGS: 3, M_REGS: 2, OP_REGS: 2) dsp2
    bool[7] fpopmode1 = C_MINUS_PC
    when sel {
        fpopmode1 = M_MINUS_PC
    }
    dsp2.apply(b, 1.0, a, pcout1, fpopmode1)
    float _t1 = dsp2.fpm_out
    rl  = dsp2.fpa_out
    rlc = dsp2.pcout

    /*
    two<T> res;
    bool sel = a_exp > b_exp;
    res.h = a + b;
    T z = res.h - (sel ? a : b);
    res.l = (sel ? b : a) - z;
    return res;
    */

}

module FastTwoSum#(int A_LATENCY, bool LATE_RH) {
    clock aclk

    gen int A0_LATENCY = 0
    gen int A1_LATENCY = A_LATENCY
    if A_LATENCY == 4 {
        A0_LATENCY = 3
        A1_LATENCY = 1
    } else if A_LATENCY == 5 {
        A0_LATENCY = 4
        A1_LATENCY = 1
    } else if A_LATENCY == 6 {
        A0_LATENCY = 4
        A1_LATENCY = 2
    } else if A_LATENCY == 7 {
        A0_LATENCY = 4
        A1_LATENCY = 3
    }

    input float a'-A_LATENCY
    input float b'0
    input float bc'0

    output float rh
    output float rl
    output float rhc
    output float rlc

    float rh1
    float a2
    if A0_LATENCY == 0 {
        dspfp32_add_c_pcin#(C_REGS: A1_LATENCY) dsp0
        dsp0.apply(a, bc)
        rhc = dsp0.pcout
        rh1 = dsp0.fpa_out
        a2 = a
    } else {
        dspfp32_mul_a_b_add_c_pcin#(A_REGS: A0_LATENCY-2, B_REGS: 0, C_REGS: A1_LATENCY, M_REGS: 2) dsp0
        a2 = dsp0.fpm_out
        dsp0.mul(a, 1.0)
        dsp0.add(a2, bc)
        rhc = dsp0.pcout
        rh1 = dsp0.fpa_out
    }

    float z
    if A1_LATENCY <= 2 {
        dspfp32_add_nc_pcin#(C_REGS: A1_LATENCY+1) dsp1
        dsp1.apply(a2, rhc)
        z = dsp1.pcout
        float _t0 = dsp1.fpa_out
    } else {
        dspfp32_mac_a_b_pcin#(A_REGS: A1_LATENCY-1, B_REGS: 0, M_REGS: 2) dsp1
        dsp1.apply(a2, -1.0, rhc)
        z = dsp1.pcout
        float _t0 = dsp1.fpa_out
        float _t1 = dsp1.fpm_out
    }

    if !LATE_RH {
        dspfp32_add_c_npcin#(C_REGS: 2) dsp2
        dsp2.apply(b, z)
        rlc = dsp2.pcout
        rl = dsp2.fpa_out
        rh = rh1
    } else {
        dspfp32_mul_a_b_add_c_npcin#(A_REGS: 1, B_REGS: 0, C_REGS: 2, M_REGS: 1) dsp2
        dsp2.mul(rh1, 1.0)
        dsp2.add(b, z)
        rlc = dsp2.pcout
        rl = dsp2.fpa_out
        rh = dsp2.fpm_out
    }

    /*
        two<T> res;
        res.h = a + b;
        T z = res.h - a;
        res.l = b - z;
        return res;
    */

}

module TwoProd {
    clock aclk

    input float a'0
    input float b'0

    output float rh
    output float rh_late
    output float rl
    output float rlc

    // ################################
    // ##  inline Split  ##############
    float sa1_x = a

    gen int MANTISSA_BITS = 22
    gen int SplitS = pow#(B: 2, E: MANTISSA_BITS / 2) + 1
    gen float SplitC = 2049.0

    // p = x * SplitC
    // q = x - p
    dspfp32_mac_na_b_c#(A_REGS: 1, B_REGS: 1, C_REGS: 2, M_REGS: 1) sa1_dsp0
    sa1_dsp0.apply(sa1_x, SplitC, sa1_x)
    float sa1_p   = sa1_dsp0.fpm_out
    float _sa1_t0 = sa1_dsp0.fpa_out
    float sa1_q   = sa1_dsp0.pcout
    float sa1_xc  = sa1_dsp0.acout

    // x1 = p + q
    dspfp32_mul_acin_b_add_c_pcin#(A_REGS: 0, B_REGS: 1, C_REGS: 1, M_REGS: 2) sa1_dsp1
    sa1_dsp1.add(sa1_p, sa1_q)
    float sa1_x1  = sa1_dsp1.fpa_out
    float sa1_x1c = sa1_dsp1.pcout
    float sa1_xcc = sa1_dsp1.acout

    // x2 = x - x1
    dspfp32_mac_acin_b_npcin#(A_REGS: 1, B_REGS: 0, M_REGS: 2) sa1_dsp2
    sa1_dsp2.apply(sa1_xcc, 1.0, sa1_x1c)
    float _sa1_t4 = sa1_dsp2.fpm_out
    float sa1_x2  = sa1_dsp2.fpa_out
    float _sa1_t5 = sa1_dsp2.pcout
    float a1h = sa1_x1
    float a1l = sa1_x2
    // ################################

    // ################################
    // ##  inline Split  ##############
    float sb1_x = b

    // p = x * SplitC
    // q = x - p
    dspfp32_mac_na_b_c#(A_REGS: 1, B_REGS: 1, C_REGS: 2, M_REGS: 1) sb1_dsp0
    sb1_dsp0.apply(SplitC, sb1_x, sb1_x)
    float sb1_p   = sb1_dsp0.fpm_out
    float _sb1_t0 = sb1_dsp0.fpa_out
    float sb1_q   = sb1_dsp0.pcout
    float sb1_xc  = sb1_dsp0.bcout

    // x1 = p + q
    dspfp32_mul_a_d_add_c_pcin_carry_bcin#(A_REGS: 2, B_REGS: 0, C_REGS: 1, D_REGS: 1, M_REGS: 2) sb1_dsp1
    sb1_dsp1.add(sb1_p, sb1_q)
    sb1_dsp1.carry(sb1_xc)
    float sb1_x1  = sb1_dsp1.fpa_out
    float sb1_x1c = sb1_dsp1.pcout
    float sb1_xcc = sb1_dsp1.bcout

    // x2 = x - x1
    dspfp32_mac_a_bcin_npcin#(A_REGS: 0, B_REGS: 1, M_REGS: 2) sb1_dsp2
    sb1_dsp2.apply(1.0, sb1_xcc, sb1_x1c)
    float sb1_x2  = sb1_dsp2.fpa_out
    float _sb1_t5 = sb1_dsp2.pcout
    float b1h = sb1_x1
    float b1l = sb1_x2
    // ################################

    // use free multipliers
    // rh = a * b = sa1_xc * b
    sa1_dsp1.mul(sa1_xc, b)
    float rh2 = sa1_dsp1.fpm_out
    rh = rh2
    // delay rh
    sb1_dsp1.mul(rh2, 1.0)
    float rh3 = sb1_dsp1.fpm_out
    rh_late = rh3

    // r.l = ((a1.h * b1.h - r.h) + a1.h * b1.l + a1.l * b1.h) + a1.l * b1.l;

    // tmp0 = a1h * b1h - rh
    dspfp32_mac_a_b_nc#(A_REGS: 1, B_REGS: 1, C_REGS: 3, M_REGS: 1) dsp1
    dsp1.apply(a1h, b1h, rh2)
    float _t3   = dsp1.fpm_out
    float _t4   = dsp1.fpa_out
    float tmp0  = dsp1.pcout
    float a1hc  = dsp1.acout
    float b1hc  = dsp1.bcout

    // tmp1 = a1h * b1l + tmp0
    dspfp32_mac_acin_d_pcin_carry_bcin#(A_REGS: 1, B_REGS: 1, D_REGS: 1, M_REGS: 1) dsp2
    dsp2.apply(a1hc, b1l, tmp0)
    dsp2.carry(b1hc)
    float tmp1 = dsp2.pcout
    float b1hcc = dsp2.bcout

    // tmp2 = a1l * b1h + tmp1
    dspfp32_mac_a_bcin_pcin_carry_d#(A_REGS: 1, B_REGS: 0, D_REGS: 1, M_REGS: 2) dsp3
    dsp3.apply(a1l, b1hcc, tmp1)
    dsp3.carry(b1l)
    float a1lc = dsp3.acout
    float b1lc = dsp3.bcout
    float tmp2 = dsp3.pcout

    // tmp3 = a1l * b1l + tmp2
    dspfp32_mac_acin_b_pcin#(A_REGS: 1, B_REGS: 1, M_REGS: 2) dsp4
    dsp4.apply(a1lc, b1lc, tmp2)
    float tmp3 = dsp4.fpa_out
    rl          = tmp3
    rlc         = dsp4.pcout

    /*
    two<T> res;
    res.h = a * b;

    two<T> a1 = Split(a);
    two<T> b1 = Split(b);

    // Order must be preserved to ensure the proven error bounds
    res.l = ((a1.h * b1.h - res.h) + a1.h * b1.l + a1.l * b1.h) + a1.l * b1.l;
    return res;

    Split(x):
        T p = x * SplitC;
        T q = x - p;
        T x1 = p + q;
        T x2 = x - x1;
        return {x1, x2};
    */
}

module TwoProd_LATE_RH {
    clock aclk

    input float a'0
    input float b'0

    output float rh
    output float rh_late
    output float rl
    output float rlc

    // ################################
    // ##  inline Split  ##############
    float sa1_x = a

    gen int MANTISSA_BITS = 22
    gen int SplitS = pow#(B: 2, E: MANTISSA_BITS / 2) + 1
    gen float SplitC = 2049.0

    // p = x * SplitC
    // q = x - p
    dspfp32_mac_na_b_c#(A_REGS: 1, B_REGS: 1, C_REGS: 2, M_REGS: 1) sa1_dsp0
    sa1_dsp0.apply(sa1_x, SplitC, sa1_x)
    float sa1_p   = sa1_dsp0.fpm_out
    float _sa1_t0 = sa1_dsp0.fpa_out
    float sa1_q   = sa1_dsp0.pcout
    float sa1_xc  = sa1_dsp0.acout

    // x1 = p + q
    dspfp32_mul_acin_b_add_c_pcin#(A_REGS: 0, B_REGS: 0, C_REGS: 1, M_REGS: 2) sa1_dsp1
    sa1_dsp1.mul(sa1_xc, 1.0)
    sa1_dsp1.add(sa1_p, sa1_q)
    float sa1_x1  = sa1_dsp1.fpa_out
    float sa1_x1c = sa1_dsp1.pcout
    float sa1_xccc = sa1_dsp1.fpm_out

    // x2 = x - x1
    dspfp32_mul_a_b_pcout_add_c_npcin#(A_REGS: 1, B_REGS: 1, C_REGS: 1, M_REGS: 2) sa1_dsp2
    sa1_dsp2.add(sa1_xccc, sa1_x1c)
    float sa1_x2  = sa1_dsp2.fpa_out
    float a1h = sa1_x1
    float a1l = sa1_x2
    // ################################

    // ################################
    // ##  inline Split  ##############
    float sb1_x = b

    // p = x * SplitC
    // q = x - p
    dspfp32_mac_na_b_c#(A_REGS: 1, B_REGS: 1, C_REGS: 2, M_REGS: 1) sb1_dsp0
    sb1_dsp0.apply(sb1_x, SplitC, sb1_x)
    float sb1_p   = sb1_dsp0.fpm_out
    float _sb1_t0 = sb1_dsp0.fpa_out
    float sb1_q   = sb1_dsp0.pcout
    float sb1_xc  = sb1_dsp0.acout

    // x1 = p + q
    dspfp32_mul_acin_b_add_c_pcin#(A_REGS: 0, B_REGS: 0, C_REGS: 1, M_REGS: 2) sb1_dsp1
    sb1_dsp1.mul(sb1_xc, 1.0)
    sb1_dsp1.add(sb1_p, sb1_q)
    float sb1_x1  = sb1_dsp1.fpa_out
    float sb1_x1c = sb1_dsp1.pcout
    float sb1_xccc = sb1_dsp1.fpm_out

    // x2 = x - x1
    dspfp32_mul_a_b_pcout_add_c_npcin#(A_REGS: 2, B_REGS: 0, C_REGS: 1, M_REGS: 2) sb1_dsp2
    sb1_dsp2.add(sb1_xccc, sb1_x1c)
    float sb1_x2  = sb1_dsp2.fpa_out
    float _sb1_t5 = sb1_dsp2.pcout
    float b1h = sb1_x1
    float b1l = sb1_x2
    // ################################

    // use free multipliers
    // rh = a * b = sa1_xc * b
    sa1_dsp2.mul(sa1_xccc, sb1_xccc)
    float rh2 = sa1_dsp2.fpm_out
    float rhc = sa1_dsp2.pcout
    rh = rh2
    // delay rh
    sb1_dsp2.mul(rh2, 1.0)
    float rh3 = sb1_dsp2.fpm_out
    rh_late = rh3

    // r.l = ((a1.h * b1.h - r.h) + a1.h * b1.l + a1.l * b1.h) + a1.l * b1.l;

    // tmp0 = a1h * b1h - rh
    dspfp32_mac_a_b_npcin#(A_REGS: 1, B_REGS: 1, M_REGS: 1) dsp1
    dsp1.apply(a1h, b1h, rhc)
    float _t3   = dsp1.fpm_out
    float _t4   = dsp1.fpa_out
    float tmp0  = dsp1.pcout
    float a1hc  = dsp1.acout
    float b1hc  = dsp1.bcout

    // tmp1 = a1h * b1l + tmp0
    dspfp32_mac_acin_d_pcin_carry_bcin#(A_REGS: 1, B_REGS: 1, D_REGS: 1, M_REGS: 1) dsp2
    dsp2.apply(a1hc, b1l, tmp0)
    dsp2.carry(b1hc)
    float tmp1 = dsp2.pcout
    float b1hcc = dsp2.bcout

    // tmp2 = a1l * b1h + tmp1
    dspfp32_mac_a_bcin_pcin_carry_d#(A_REGS: 1, B_REGS: 0, D_REGS: 1, M_REGS: 2) dsp3
    dsp3.apply(a1l, b1hcc, tmp1)
    dsp3.carry(b1l)
    float a1lc = dsp3.acout
    float b1lc = dsp3.bcout
    float tmp2 = dsp3.pcout

    // tmp3 = a1l * b1l + tmp2
    dspfp32_mac_acin_b_pcin#(A_REGS: 1, B_REGS: 1, M_REGS: 2) dsp4
    dsp4.apply(a1lc, b1lc, tmp2)
    float tmp3 = dsp4.fpa_out
    rl          = tmp3
    rlc         = dsp4.pcout

    /*
    two<T> res;
    res.h = a * b;

    two<T> a1 = Split(a);
    two<T> b1 = Split(b);

    // Order must be preserved to ensure the proven error bounds
    res.l = ((a1.h * b1.h - res.h) + a1.h * b1.l + a1.l * b1.h) + a1.l * b1.l;
    return res;

    Split(x):
        T p = x * SplitC;
        T q = x - p;
        T x1 = p + q;
        T x2 = x - x1;
        return {x1, x2};
    */
}

// ################################################################
// ##  Extern  ####################################################
// ################################################################

extern module dspfp32_ip #(int A_REGS, int AC_REGS, int B_REGS, int C_REGS, int D_REGS, int M_REGS, int OP_REGS, int ACIN, int BCIN, int DCOUT, int PCOUT_FPA) {

    assert#(C: 0 <= A_REGS & A_REGS <= 2)
    assert#(C: (A_REGS == 0 & AC_REGS == 0) | (A_REGS == 1 & AC_REGS == 1) | (A_REGS == 2 & (AC_REGS == 1 | AC_REGS == 2)))
    assert#(C: 0 <= B_REGS & B_REGS <= 1)
    assert#(C: 0 <= C_REGS & C_REGS <= 3)
    assert#(C: 0 <= D_REGS & D_REGS <= 1)
    assert#(C: 0 <= M_REGS & M_REGS <= 2)
    assert#(C: 0 <= OP_REGS & OP_REGS <= 3)
    assert#(C: 0 <= PCOUT_FPA & PCOUT_FPA <= 1)

    clock aclk
    input float a'-(A_REGS+M_REGS)
    input float acin'-(A_REGS+M_REGS)
    input bool fpinmode'-(1+M_REGS)
    output float fpm_out'0
    output float acout'-M_REGS-A_REGS+AC_REGS

    domain clk1
    input float b'0
    input float bcin'0

    domain clk2
    output float bcout'0

    domain clk3
    input float d'0

    domain clk4
    input float c'-C_REGS
    input float pcin'0
    input bool[7] fpopmode'-OP_REGS
    output float fpa_out'1

    domain clk5
    output float pcout'PCOUT_FPA

}

module dspfp32_add_c_d#(int C_REGS, int D_REGS) {
    clock aclk

    output float fpa_out'1
    output float pcout'1

    dspfp32_ip#(A_REGS: 0, AC_REGS: 0, B_REGS: 0, C_REGS: C_REGS, D_REGS: D_REGS, M_REGS: 0, OP_REGS: 0, ACIN: 0, BCIN: 0, DCOUT: 0, PCOUT_FPA: 1) ip

    interface apply: float c'-(C_REGS), float d'-D_REGS {
        ip.a = 0.0
        ip.b = 0.0
        ip.c = c
        ip.d = d
        ip.acin = 0.0
        ip.bcin = 0.0
        ip.pcin = 0.0
        ip.fpinmode = true
        //               ++ +C  +D
        ip.fpopmode = 7'b00_110_11
    }

    float _fpm_out = ip.fpm_out
    fpa_out = ip.fpa_out
    float _acout = ip.acout
    float _bcout = ip.bcout
    pcout = ip.pcout
}

module dspfp32_add_c_pcin#(int C_REGS) {
    clock aclk

    output float fpa_out'1
    output float pcout'1

    dspfp32_ip#(A_REGS: 0, AC_REGS: 0, B_REGS: 0, C_REGS: C_REGS, D_REGS: 0, M_REGS: 0, OP_REGS: 0, ACIN: 0, BCIN: 0, DCOUT: 0, PCOUT_FPA: 1) ip

    interface apply: float c'-(C_REGS), float pcin'0 {
        ip.a = 0.0
        ip.b = 0.0
        ip.c = c
        ip.d = 0.0
        ip.acin = 0.0
        ip.bcin = 0.0
        ip.pcin = pcin
        ip.fpinmode = true
        //               ++ +C  +PCIN
        ip.fpopmode = 7'b00_110_10
    }

    float _fpm_out = ip.fpm_out
    fpa_out = ip.fpa_out
    float _acout = ip.acout
    float _bcout = ip.bcout
    pcout = ip.pcout
}

module dspfp32_add_nc_pcin#(int C_REGS) {
    clock aclk

    output float fpa_out'1
    output float pcout'1

    dspfp32_ip#(A_REGS: 0, AC_REGS: 0, B_REGS: 0, C_REGS: C_REGS, D_REGS: 0, M_REGS: 0, OP_REGS: 0, ACIN: 0, BCIN: 0, DCOUT: 0, PCOUT_FPA: 1) ip

    interface apply: float c'-(C_REGS), float pcin'0 {
        ip.a = 0.0
        ip.b = 0.0
        ip.c = c
        ip.d = 0.0
        ip.acin = 0.0
        ip.bcin = 0.0
        ip.pcin = pcin
        ip.fpinmode = true
        //               -+ -C  +PCIN
        ip.fpopmode = 7'b10_110_10
    }

    float _fpm_out = ip.fpm_out
    fpa_out = ip.fpa_out
    float _acout = ip.acout
    float _bcout = ip.bcout
    pcout = ip.pcout
}

module dspfp32_add_c_npcin#(int C_REGS) {
    clock aclk

    output float fpa_out'1
    output float pcout'1

    dspfp32_ip#(A_REGS: 0, AC_REGS: 0, B_REGS: 0, C_REGS: C_REGS, D_REGS: 0, M_REGS: 0, OP_REGS: 0, ACIN: 0, BCIN: 0, DCOUT: 0, PCOUT_FPA: 1) ip

    interface apply: float c'-(C_REGS), float pcin'0 {
        ip.a = 0.0
        ip.b = 0.0
        ip.c = c
        ip.d = 0.0
        ip.acin = 0.0
        ip.bcin = 0.0
        ip.pcin = pcin
        ip.fpinmode = true
        //               -+ +C  -PCIN
        ip.fpopmode = 7'b01_110_10
    }

    float _fpm_out = ip.fpm_out
    fpa_out = ip.fpa_out
    float _acout = ip.acout
    float _bcout = ip.bcout
    pcout = ip.pcout
}

module dspfp32_add_c_d_pcin_op#(int C_REGS, int D_REGS, int OP_REGS) {
    clock aclk

    output float fpa_out'1
    output float pcout'1

    dspfp32_ip#(A_REGS: 0, AC_REGS: 0, B_REGS: 0, C_REGS: C_REGS, D_REGS: D_REGS, M_REGS: 0, OP_REGS: OP_REGS, ACIN: 0, BCIN: 0, DCOUT: 0, PCOUT_FPA: 1) ip

    interface apply: float c'-C_REGS, float d'-D_REGS, float pcin'0, bool[7] fpopmode'-OP_REGS {
        ip.a = 0.0
        ip.b = 0.0
        ip.c = c
        ip.d = d
        ip.acin = 0.0
        ip.bcin = 0.0
        ip.pcin = pcin
        ip.fpinmode = true
        ip.fpopmode = fpopmode
    }

    float _fpm_out = ip.fpm_out
    fpa_out = ip.fpa_out
    float _acout = ip.acout
    float _bcout = ip.bcout
    pcout = ip.pcout
}

module dspfp32_mul_a_b#(int A_REGS, int B_REGS, int M_REGS) {
    clock aclk

    output float fpm_out'0
    output float pcout'0

    dspfp32_ip#(A_REGS: A_REGS, AC_REGS: A_REGS, B_REGS: B_REGS, C_REGS: 0, D_REGS: 0, M_REGS: M_REGS, OP_REGS: 0, ACIN: 0, BCIN: 0, DCOUT: 0, PCOUT_FPA: 0) ip

    interface apply: float a'-(A_REGS+M_REGS), float b'-(B_REGS+M_REGS) {
        ip.a = a
        ip.b = b
        ip.c = 0.0
        ip.d = 0.0
        ip.acin = 0.0
        ip.bcin = 0.0
        ip.pcin = 0.0
        ip.fpinmode = true
        ip.fpopmode = 7'b00_000_00
    }

    fpm_out = ip.fpm_out
    float _fpa_out = ip.fpa_out
    float _acout = ip.acout
    float _bcout = ip.bcout
    pcout = ip.pcout
}

module dspfp32_mac_a_b_pcin#(int A_REGS, int B_REGS, int M_REGS) {
    clock aclk

    output float fpm_out'0
    output float fpa_out'1
    output float acout'-M_REGS
    output float bcout'-M_REGS
    output float pcout'1

    dspfp32_ip#(A_REGS: A_REGS, AC_REGS: A_REGS, B_REGS: B_REGS, C_REGS: 0, D_REGS: 0, M_REGS: M_REGS, OP_REGS: 0, ACIN: 0, BCIN: 0, DCOUT: 0, PCOUT_FPA: 1) ip

    interface apply: float a'-(A_REGS+M_REGS), float b'-(B_REGS+M_REGS), float pcin'0 {
        ip.a = a
        ip.b = b
        ip.c = 0.0
        ip.d = 0.0
        ip.acin = 0.0
        ip.bcin = 0.0
        ip.pcin = pcin
        ip.fpinmode = true
        //               ++ +PCIN +M
